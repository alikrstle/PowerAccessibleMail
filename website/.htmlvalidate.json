{
  "extends": ["html-validate:recommended"],
  "rules": {
    "attr-quotes": "error",
    "doctype-style": "error",
    "element-required-attributes": "error",
    "no-inline-style": "error",
    "no-redundant-role": "off",
    "prefer-native-element": "error",
    "wcag/h30": "error",
    "wcag/h32": "error",
    "wcag/h36": "error",
    "wcag/h37": "error",
    "wcag/h63": "error",
    "wcag/h67": "error",
    "wcag/h71": "error"
  }
}

